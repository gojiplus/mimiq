{
  "name": "@gojiplus/mimiq",
  "version": "0.6.0",
  "description": "Application-layer user simulation with replayable browser evidence",
  "type": "module",
  "workspaces": [
    "examples/playwright",
    "examples/cypress"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./cypress": {
      "types": "./dist/adapters/cypress/index.d.ts",
      "default": "./dist/adapters/cypress/index.js"
    },
    "./playwright": {
      "types": "./dist/adapters/playwright/index.d.ts",
      "default": "./dist/adapters/playwright/index.js"
    },
    "./simulators": {
      "types": "./dist/simulators/index.d.ts",
      "default": "./dist/simulators/index.js"
    }
  },
  "bin": {
    "mimiq": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "dev:app": "npm run dev --prefix test/app",
    "test:cypress": "npm test --prefix examples/cypress",
    "test:playwright": "npm test --prefix examples/playwright",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test": "npm run test:unit",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0",
    "cypress": "^15.16.0"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.15",
    "@types/nunjucks": "^3.2.6",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cypress": "^15.16.0",
    "dotenv": "^17.3.1",
    "eslint": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.4.0",
    "yaml": "^2.8.2"
  },
  "keywords": [
    "cypress",
    "playwright",
    "testing",
    "e2e",
    "agent",
    "simulation",
    "mimiq",
    "llm",
    "chatbot",
    "browser-agent"
  ],
  "author": "Gaurav Sood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojiplus/mimiq.git"
  },
  "bugs": {
    "url": "https://github.com/gojiplus/mimiq/issues"
  },
  "homepage": "https://github.com/gojiplus/mimiq#readme",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.40",
    "ai": "^6.0.116",
    "commander": "^14.0.3",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1"
  },
  "overrides": {
    "playwright": "$@playwright/test",
    "esbuild": "^0.28.2"
  }
}
